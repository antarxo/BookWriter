{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/book-schema-v1.schema.json",
  "title": "Γενικό βιβλίο σελίδων",
  "type": "object",
  "required": ["schemaVersion", "meta", "layoutDefaults", "pages"],
  "properties": {
    "schemaVersion": {
      "const": "pages-v1"
    },
    "meta": {
      "type": "object",
      "properties": {
        "projectId": {"type": "string"},
        "fileName": {"type": "string"},
        "title": {"type": "string"},
        "title_en": {"type": "string"},
        "subtitle": {"type": "string"},
        "subtitle_en": {"type": "string"},
        "appHref": {"type": "string"},
        "defaultLanguage": {"enum": ["el", "en"]},
        "languages": {
          "type": "array",
          "items": {"enum": ["el", "en"]},
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "layoutDefaults": {
      "type": "object",
      "properties": {
        "pageSize": {"type": "string"},
        "orientation": {"enum": ["portrait", "landscape"]},
        "pageWidthPx": {"type": "number", "exclusiveMinimum": 0},
        "pageHeightPx": {"type": "number", "exclusiveMinimum": 0},
        "pagePaddingTopPx": {"type": "number", "minimum": 0},
        "pagePaddingRightPx": {"type": "number", "minimum": 0},
        "pagePaddingBottomPx": {"type": "number", "minimum": 0},
        "pagePaddingLeftPx": {"type": "number", "minimum": 0},
        "bodyFontSize": {"type": "number", "exclusiveMinimum": 0},
        "lineHeight": {"type": "number", "exclusiveMinimum": 0},
        "showPageNumbers": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "nav": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["auto", "manual"]},
        "showApp": {"type": "boolean"},
        "showPrint": {"type": "boolean"},
        "groups": {"type": "array"}
      },
      "additionalProperties": true
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "items"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "header": {"$ref": "#/$defs/threeColumns"},
          "footer": {"$ref": "#/$defs/threeColumns"},
          "items": {
            "type": "array",
            "items": {"$ref": "#/$defs/pageItem"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "threeColumns": {
      "type": "object",
      "properties": {
        "left": {"type": "string"},
        "center": {"type": "string"},
        "right": {"type": "string"},
        "left_en": {"type": "string"},
        "center_en": {"type": "string"},
        "right_en": {"type": "string"}
      },
      "additionalProperties": true
    },
    "pageItem": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "hero",
            "part_title",
            "section_heading",
            "paragraph",
            "note",
            "side_note",
            "figure",
            "scene",
            "interactive_callout",
            "nav_anchor",
            "clear"
          ]
        },
        "id": {"type": "string"},
        "showInNav": {"type": "boolean"},
        "placement": {"enum": ["left", "right", "wide", "float-left", "float-right"]},
        "frameWidth": {"type": "number", "exclusiveMinimum": 0},
        "frameHeight": {"type": "number", "exclusiveMinimum": 0},
        "sceneHeight": {"type": "number", "exclusiveMinimum": 0},
        "aspectRatio": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "string", "minLength": 1}
          ]
        },
        "src": {"type": "string"},
        "singleSrc": {"type": "string"},
        "hideCaption": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
